{
  "manifest_version": 3,
  "name": "ShortStop: Block Shorts, Reels & Endless Feeds",
  "short_name": "ShortStop",
  "version": "1.0.0",
  "description": "Blocks Shorts, Reels, Spotlight and endless feeds on YouTube, Instagram, Facebook, TikTok, Reddit, X and Snapchat. No tracking.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ShortStop",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://www.instagram.com/*",
    "*://www.facebook.com/*",
    "*://web.facebook.com/*",
    "*://m.facebook.com/*",
    "*://*.tiktok.com/*",
    "*://www.reddit.com/*",
    "*://old.reddit.com/*",
    "*://x.com/*",
    "*://mobile.x.com/*",
    "*://twitter.com/*",
    "*://mobile.twitter.com/*",
    "*://www.snapchat.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://www.instagram.com/*",
        "*://www.facebook.com/*",
        "*://web.facebook.com/*",
        "*://m.facebook.com/*",
        "*://*.tiktok.com/*",
        "*://www.reddit.com/*",
        "*://old.reddit.com/*",
        "*://x.com/*",
        "*://mobile.x.com/*",
        "*://twitter.com/*",
        "*://mobile.twitter.com/*",
        "*://www.snapchat.com/*"
      ],
      "js": [
        "content/nav-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "shared/schedule.js",
        "content/core.js",
        "content/youtube.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.instagram.com/*"
      ],
      "js": [
        "shared/schedule.js",
        "content/core.js",
        "content/instagram.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.facebook.com/*",
        "*://web.facebook.com/*",
        "*://m.facebook.com/*"
      ],
      "js": [
        "shared/schedule.js",
        "content/core.js",
        "content/facebook.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.tiktok.com/*"
      ],
      "js": [
        "shared/schedule.js",
        "content/core.js",
        "content/tiktok.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.reddit.com/*",
        "*://old.reddit.com/*"
      ],
      "js": [
        "shared/schedule.js",
        "content/core.js",
        "content/reddit.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://x.com/*",
        "*://mobile.x.com/*",
        "*://twitter.com/*",
        "*://mobile.twitter.com/*"
      ],
      "js": [
        "shared/schedule.js",
        "content/core.js",
        "content/x.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.snapchat.com/*"
      ],
      "js": [
        "shared/schedule.js",
        "content/core.js",
        "content/snapchat.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "start-focus-session": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Start a 1-hour focus session (press twice to confirm)"
    }
  }
}
